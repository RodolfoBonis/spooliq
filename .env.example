# Application Configuration
PORT=8000
ENV=development
SERVICE_ID=spooliq-service

# Database Configuration
DB_DRIVER=postgres# postgres ou sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_SECRET=password
DB_NAME=spooliq_db

# SQLite Configuration (usado quando DB_DRIVER=sqlite)
DB_SQLITE_PATH=./spooliq.db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# Authentication Configuration
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
REALM=your_realm
KEYCLOAK_HOST=your_keycloak_host

# Build Configuration (for Docker build with private repositories)
GITHUB_TOKEN=your_github_personal_access_token
VERSION=latest

# Optional: Sentry Configuration
SENTRY_DSN=your_sentry_dsn

# Optional: AMQP Configuration
AMQP_CONNECTION=amqp://user:password@localhost:5672/

# ============================================
# OpenTelemetry / Observability (go-otel-agent)
# ============================================
# Only 3 required vars - all others have smart defaults.
# See: https://github.com/RodolfoBonis/go-otel-agent
OTEL_SERVICE_NAME=spooliq-api
OTEL_SERVICE_NAMESPACE=spooliq
OTEL_SERVICE_VERSION=1.0.0

# Optional overrides (uncomment to customize):
# OTEL_EXPORTER_OTLP_ENDPOINT=signoz-otel-collector.signoz.svc.cluster.local:4317
# OTEL_TRACES_SAMPLER_ARG=0.1  (10% sampling for production)
# ENV=production

# ===========================================
# ASAAS PAYMENT GATEWAY CONFIGURATION
# ===========================================
# Asaas API Configuration
ASAAS_API_KEY=your_asaas_api_key_here
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# For production, use: https://www.asaas.com/api/v3

# Asaas Webhook Configuration
# IMPORTANT: Generate a strong secret to validate webhook authenticity
# You can generate one using: openssl rand -base64 32
ASAAS_WEBHOOK_SECRET=your_webhook_secret_here
